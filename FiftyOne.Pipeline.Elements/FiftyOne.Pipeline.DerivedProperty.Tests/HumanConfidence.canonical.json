{
  "Format": 1,
  "Name": "HumanConfidence",
  "Version": "0.2.0",
  "Output": {
    "Name": "HumanConfidence",
    "Description": "The confidence that the request came from a device being used by a human who is viewing the page. Returns one of High, Medium, or Low.",
    "ValueType": "string",
    "IsList": false,
    "IsMandatory": false,
    "IsObsolete": false,
    "Category": "General",
    "IsPopular": true,
    "ExportValues": true,
    "Dependencies": [
      "device.IsCrawler",
      "device.BrowserReleaseYear",
      "device.BrowserReleaseAge",
      "ip.HumanProbability"
    ],
    "Values": [
      {
        "Name": "High",
        "Description": "High confidence that the request is from a device being used by a human who is viewing the page."
      },
      {
        "Name": "Medium",
        "Description": "The evidence is mixed and the request cannot be placed either way. A human may be viewing the page."
      },
      {
        "Name": "Low",
        "Description": "Almost certainly no human is directly involved in viewing the page content."
      }
    ]
  },
  "Properties": {
    "device.IsCrawler": {
      "Type": "bool"
    },
    "device.BrowserReleaseYear": {
      "Type": "int"
    },
    "device.BrowserReleaseAge": {
      "Type": "int"
    },
    "ip.HumanProbability": {
      "Type": "int"
    }
  },
  "Checks": {
    "NotCrawler": {
      "Property": "device.IsCrawler",
      "Eq": false
    },
    "Current": {
      "All": [
        {
          "Property": "device.BrowserReleaseYear",
          "Gt": 0
        },
        {
          "Property": "device.BrowserReleaseAge",
          "Lt": 2
        }
      ]
    },
    "HumanOrUnrated": {
      "Any": [
        {
          "Property": "ip.HumanProbability",
          "Ge": 8
        },
        {
          "Property": "ip.HumanProbability",
          "Lt": 0
        }
      ]
    }
  },
  "Rules": [
    {
      "When": {
        "Property": "device.IsCrawler",
        "Eq": true
      },
      "Then": "Low"
    },
    {
      "When": {
        "Failed": "Checks",
        "Eq": 0
      },
      "Then": "High"
    },
    {
      "When": {
        "Failed": "Checks",
        "Le": 1
      },
      "Then": "Medium"
    },
    {
      "Else": "Low"
    }
  ]
}